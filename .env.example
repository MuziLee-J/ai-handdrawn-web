# 复制为 .env.local 使用；不要提交真实密钥。

# AI 供应商：ark | mock
# 未填写 ARK_API_KEY 且 ALLOW_MOCK_AI=true 时，开发环境使用演示图。
# 演示图不是 AI 生成结果，界面会明确标识。
AI_PROVIDER=ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 当前测试使用 Seedream 5.0 Flash（0.12 元/张）。
# 若使用 Seedream 4.0，改为 doubao-seedream-4-0-20260415，参考价 0.20 元/张。
ARK_MODEL=doubao-seedream-5-0-flash-260915
ARK_TIMEOUT_MS=120000

# 参考单价（分/张）。5.0 Flash: 12；4.0: 20；5.0 Pro: 30–60。以实际账单为准。
AI_COST_CENTS_PER_IMAGE=12

# 仅开发/演示环境允许 mock。生产环境请设为 false。
ALLOW_MOCK_AI=true

# 本地数据目录：SQLite 与上传/生成文件。
# 放在项目外可避免 next dev 监视上传/生成文件而触发 HMR 刷新。
# 部署时请改为持久化卷的绝对路径，例如 /var/lib/handdrawn/.data。
DATA_DIR=../handdrawn-data

# 服务端口
PORT=3000

# 额度控制（MVP 防误触与费用保护）
DAILY_LIMIT_PER_SESSION=10
DAILY_LIMIT_GLOBAL=60

# 进程内任务队列
TASK_CONCURRENCY=2
STALE_TASK_MINUTES=10

# 进程内限流（批量测试可临时提高；生产建议保持较严格）
RATE_LIMIT_GENERATE_PER_MINUTE=6
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# 上传限制
MAX_UPLOAD_MB=15
MAX_IMAGE_PIXELS=36000000
